{
  "name": "drift",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun run check && bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src tests scripts && prettier --check .",
    "format": "biome check --write src tests scripts && prettier --write .",
    "test": "bun test tests/unit",
    "test:e2e": "bun --bun playwright test",
    "validate": "bun run check && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "prettier": "^3.10.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.72.0",
    "svelte": "^5.57.3"
  },
  "version": "0.1.0",
  "description": "A considered, lightweight Transmission interface.",
  "license": "MIT"
}
