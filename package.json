{
  "name": "drift",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun run check && bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src tests scripts && bun fmt --check .",
    "format": "biome check --write src tests scripts && bun fmt .",
    "test": "bun test tests/unit",
    "test:e2e": "bun --bun node_modules/@playwright/test/cli.js test",
    "test:legacy": "bun scripts/legacy.ts",
    "validate": "bun run check && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "playwright-legacy": "npm:playwright-core@1.20.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.72.0",
    "@videojs/html": "^10.3.0",
    "construct-style-sheets-polyfill": "^3.1.0",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "layerchart": "^2.10.0",
    "svelte": "^5.57.3",
    "wicg-inert": "^3.1.3"
  },
  "version": "0.1.0",
  "description": "A considered, lightweight Transmission interface.",
  "license": "MIT"
}
