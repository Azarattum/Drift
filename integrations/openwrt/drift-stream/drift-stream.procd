# Sourced inside transmission() immediately after its procd_close_instance.
# These are the existing init script's local values, not a second configuration.
procd_open_instance "drift-stream-$cfg"
procd_set_param command /usr/bin/drift-stream --config-dir "$config_dir"
procd_set_param user "$user"
procd_set_param group "$group"
procd_set_param stderr 1
procd_set_param limits core="0 0" nofile="64 64"
procd_set_param term_timeout 2
# Startup discovery is bounded; subsequent process exits use pidfd, not polling.
# During a Transmission restart this instance waits for its replacement process.
# Stopping the parent service stops both instances and disables their respawns.
procd_set_param respawn 3600 1 5
procd_close_instance
