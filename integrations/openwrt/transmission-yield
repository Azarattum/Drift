#!/bin/sh
# Runtime-only RPC limits: no periodic writes to flash or torrent pause/resume.
. /lib/functions.sh
config_load transmission_yield
config_get interval main interval 2
config_get hold main idle_seconds 20
config_get threshold main traffic_bytes_per_second 2048
config_get down main busy_download_kbytes 128
config_get up main busy_upload_kbytes 32
config_get minmem main minimum_available_kbytes 24576
config_get maxcpu main maximum_cpu_percent 70
config_get rpc main rpc '127.0.0.1:9091'

read_cpu() {
    read _ user nice system idle iowait irq softirq steal rest < /proc/stat
    total=$((user + nice + system + idle + iowait + irq + softirq + steal))
    quiet=$((idle + iowait))
}

read_traffic() {
    bytes=$(nft list counter inet fw4 transmission_yield_traffic 2>/dev/null |
        awk '/packets/ {print $4}')
    case "$bytes" in ''|*[!0-9]*) return 1;; esac
}

apply_mode() {
    if [ "${priority_active:-0}" -gt 0 ] || [ "$1" = idle ]; then
        transmission-remote "$rpc" -D -U >/dev/null 2>&1 || return 1
    else
        transmission-remote "$rpc" -d "$down" -u "$up" >/dev/null 2>&1 || return 1
    fi
    [ "$mode" = "$1" ] || logger -t transmission-yield "$1: $reason"
    mode=$1
    printf 'mode=%s\nreason=%s\nother_bytes_per_second=%s\ncpu_percent=%s\navailable_kbytes=%s\n' \
        "$mode" "$reason" "${rate:-0}" "${cpu:-0}" "${available:-0}" > /var/run/transmission-yield.status
}

# Leave conservative limits in place if this service is stopped.
trap 'reason="controller stopped"; apply_mode busy; exit 0' TERM INT
mode=unknown
reason='starting; waiting for idle network'
idle_time=0
ticks=0
priority_error=0
read_cpu
previous_total=$total
previous_quiet=$quiet
read_traffic || bytes=0
previous_bytes=$bytes
apply_mode busy

while :; do
    sleep "$interval" &
    wait $!
    # A selected torrent bypasses session limits; ordinary downloads still yield.
    # Reconcile on the router so closing the browser never strands an override.
    if priority_active=$(/usr/bin/ucode /usr/libexec/transmission-priority.uc 2>/dev/null); then
        priority_error=0
    else
        priority_active=0
        if [ "$priority_error" = 0 ]; then
            logger -t transmission-yield 'Full speed controller failed; will retry'
            priority_error=1
        fi
    fi
    read_cpu
    delta_total=$((total - previous_total))
    delta_quiet=$((quiet - previous_quiet))
    previous_total=$total
    previous_quiet=$quiet
    cpu=0
    [ "$delta_total" -gt 0 ] && cpu=$((100 * (delta_total - delta_quiet) / delta_total))
    available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
    available=${available:-0}
    reason='network idle; resource headroom available'
    busy=0
    rate=0
    if read_traffic; then
        delta=$((bytes - previous_bytes))
        previous_bytes=$bytes
        # Firewall reload resets counters; wait for a fresh sample.
        if [ "$delta" -lt 0 ]; then
            busy=1
            reason='traffic counters reset'
        else
            rate=$((delta / interval))
            if [ "$rate" -ge "$threshold" ]; then
                busy=1
                reason='other network traffic active'
            fi
        fi
    else
        busy=1
        reason='traffic monitor unavailable'
    fi
    if [ "$cpu" -ge "$maxcpu" ]; then
        busy=1
        reason='CPU busy'
    fi
    if [ "$available" -lt "$minmem" ]; then
        busy=1
        reason='low available memory'
    fi
    if [ "$busy" = 1 ]; then
        idle_time=0
        desired=busy
    else
        idle_time=$((idle_time + interval))
        desired=$mode
        if [ "$idle_time" -ge "$hold" ]; then
            desired=idle
        else
            reason='waiting for sustained idle network'
            desired=busy
        fi
    fi
    ticks=$((ticks + 1))
    # Reapply periodically in case Transmission was restarted or changed in LuCI.
    if [ "$desired" != "$mode" ] || [ "$ticks" -ge 5 ]; then
        apply_mode "$desired" || mode=unknown
        ticks=0
    else
        printf 'mode=%s\nreason=%s\nother_bytes_per_second=%s\ncpu_percent=%s\navailable_kbytes=%s\n' \
            "$mode" "$reason" "$rate" "$cpu" "$available" > /var/run/transmission-yield.status
    fi
done
